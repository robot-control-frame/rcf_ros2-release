<?xml version="1.0"?>
<package format="2">
  <name>rcf_hardware_interface</name>
  <version>0.0.1</version>
  <description>RCF extensions to ros2_control hardware interfaces: control mode definitions and lightweight joint command/state handle types.</description>
  <maintainer email="liaolunjia@gmail.com">廖伦稼</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/robot-control-frame/rcf_ros2</url>
  <url type="bugtracker">https://github.com/robot-control-frame/rcf_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>control_msgs</depend>
  <depend>rclcpp</depend>
  <depend>hardware_interface</depend>
  <depend>controller_interface</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
