<?xml version="1.0"?>
<package format="3">
  <name>rcf</name>
  <version>0.0.1</version>
  <description>Metapackage for the complete RCF control framework: common utilities, hardware/joint-limit/transmission interfaces, the standard servo hardware interface and its fake driver plugin.</description>

  <maintainer email="liaolunjia@gmail.com">廖伦稼</maintainer>

  <license>Apache-2.0</license>
  <url type="repository">https://github.com/robot-control-frame/rcf_ros2</url>
  <url type="bugtracker">https://github.com/robot-control-frame/rcf_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rcf_common</exec_depend>
  <exec_depend>rcf_fake_driver</exec_depend>
  <exec_depend>rcf_hardware_interface</exec_depend>
  <exec_depend>rcf_joint_limits_interface</exec_depend>
  <exec_depend>rcf_standard_driver_interface</exec_depend>
  <exec_depend>rcf_standard_hardware</exec_depend>
  <exec_depend>rcf_transmission_interface</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
