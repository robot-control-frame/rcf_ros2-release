<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rcf_joint_limits_interface</name>
  <version>0.0.1</version>
  <description>Joint limit enforcement for position, velocity and effort commands that takes the active control mode into account.</description>
  <maintainer email="liaolunjia@gmail.com">廖伦稼</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/robot-control-frame/rcf_ros2</url>
  <url type="bugtracker">https://github.com/robot-control-frame/rcf_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>joint_limits</depend>
  <depend>rcf_hardware_interface</depend>
  <depend>rclcpp</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
