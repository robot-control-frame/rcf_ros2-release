<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rcf_common</name>
  <version>0.0.1</version>
  <description>Utility library for the RCF control framework: math and orientation helpers, Eigen type aliases, low-pass/ramp/Kalman filters, shared-memory double buffer and YAML transmission parser.</description>
  <maintainer email="liaolunjia@gmail.com">廖伦稼</maintainer>
  <license>Apache-2.0</license>
  <url type="repository">https://github.com/robot-control-frame/rcf_ros2</url>
  <url type="bugtracker">https://github.com/robot-control-frame/rcf_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_gen_version_h</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>joint_limits</depend>
  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
